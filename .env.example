# Configuração do Docker Compose. Copie para ".env" (que não vai para o Git) e troque as senhas.

DB_USER=caliburger
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Portas no seu computador
WEB_PORT=8080
MYSQL_PORT=3307

# development | production. Em produção com HTTPS, use COOKIE_SECURE=true.
ENVIRONMENT=development
COOKIE_SECURE=false

# Mostra as contas de demonstração na tela de login (somente com o seed de demonstração).
SHOW_DEMO_ACCOUNTS=true
