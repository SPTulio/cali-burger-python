# Copie para backend/.env e ajuste. O arquivo .env não vai para o Git.

ENVIRONMENT=development

# MySQL principal (dados da aplicação)
DATABASE_URL=mysql+pymysql://caliburger:troque-esta-senha@127.0.0.1:3306/caliburger?charset=utf8mb4

# MySQL dos testes automatizados. Precisa ser OUTRO banco, com nome terminado em "_test":
# os testes apagam todas as tabelas dele.
TEST_DATABASE_URL=mysql+pymysql://caliburger:troque-esta-senha@127.0.0.1:3306/caliburger_test?charset=utf8mb4

# Origens permitidas (CORS), separadas por vírgula. Deixe vazio quando o frontend acessa a
# API pelo mesmo endereço (proxy do Vite em desenvolvimento ou Nginx em produção).
CORS_ORIGINS=

# true em produção (HTTPS): cookies de sessão só trafegam por conexão segura.
COOKIE_SECURE=false
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Ingredientes com quantidade menor ou igual a este valor aparecem como "estoque baixo".
LOW_STOCK_THRESHOLD=10
TIMEZONE=America/Sao_Paulo

# Pasta das imagens enviadas (padrão: backend/media)
# MEDIA_DIR=/caminho/para/media

LOG_LEVEL=INFO
